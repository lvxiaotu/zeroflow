    "validate:tldraw": "tsx ./scripts/validate-tldraw-compat.ts"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
